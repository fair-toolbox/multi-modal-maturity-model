                {
                    "project_id": 25684254,
                    "id": 96660105,
                    "iid": 4,
                    "title": "openslide bounds are incorrect",
                    "description": "The properties openslide.bounds-x, openslide.bounds-y, openslide.bounds-width and openslide.bounds-height returned by OpenPhi are invalid in the sense that the described bounding box stretches outside the WSI.\nThe bounding box is also incorrect in the sense that it does not describe the minimal box that covers all scanned areas of the slide. In some cases I have seen, the returned bounding box fail to include large parts of the scanned area.",
                    "state": "closed",
                    "created_at": "2021-11-03T12:54:29.924Z",
                    "updated_at": "2022-01-11T16:05:33.090Z",
                    "closed_at": "2022-01-11T16:05:32.115Z",
                    "closed_by": {
                        "id": 8511564,
                        "username": "kimmokartasalo",
                        "public_email": "",
                        "name": "Kimmo Kartasalo",
